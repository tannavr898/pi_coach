# Copy to .env and fill in. NEVER commit the real .env.
# Hard rule (roadmap §5/§9): every provider key lives ONLY on the backend.
# The frontend talks only to our /api/* endpoints; it never sees these.

# Anthropic API key — scenario generation + content scoring (Phase 2).
ANTHROPIC_API_KEY=

# Optional: override the content model (defaults to claude-sonnet-4-6).
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Transcription API key (Phase 3, voice). Default provider is AssemblyAI —
# create a key at assemblyai.com and SET A SPEND CAP first (roadmap §9).
# Without this, typed practice still works; the Speak option returns a 503.
TRANSCRIPTION_API_KEY=
# TRANSCRIPTION_PROVIDER=assemblyai

# Analytics (PostHog) — optional. The project key is a PUBLIC, write-only ingest
# key (safe to expose); the SPA fetches it via /api/config. Leave empty to
# disable analytics entirely. Create a project at posthog.com.
POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# Supabase — optional login + cross-session progress. Anonymous practice works
# fully without these. Create a project at supabase.com, then run
# backend/supabase/schema.sql in its SQL editor. From Project Settings → API:
#   SUPABASE_URL           = the Project URL
#   SUPABASE_ANON_KEY      = the PUBLIC "anon" key (safe client-side; served via /api/config)
#   SUPABASE_SERVICE_ROLE_KEY = the SECRET "service_role" key (backend-only; never exposed)
# Leave empty to disable login/progress entirely (the UI hides the account features).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Owner-only admin QA page at /admin (preview new features + seed canned sample
# sessions with NO LLM tokens). Set any secret string to enable it; the passphrase
# is checked server-side so it never ships in the frontend. Empty = /admin disabled.
ADMIN_PASSPHRASE=

# --- Phase 6: usage caps, tiers, video ------------------------------------
# Monthly allowances per tier. These are STARTING GUESSES, not measurements —
# they live here so they can be tuned without a deploy once there's real usage
# data to price against. -1 means unlimited. Typed practice is unlimited on
# every tier and has no knob (it costs essentially nothing, and it's the
# fallback every cap message points at).
#
# Video is capped tightest because it's the cost driver: a video session runs
# roughly 2-3x an audio-only one. Anonymous video is 0 on purpose — video
# requires an account, which is what makes its cap enforceable server-side.
# CAP_ANON_VOICE=2
# CAP_ANON_VIDEO=0
# CAP_FREE_VOICE=8
# CAP_FREE_VIDEO=3
# CAP_PRO_VOICE=-1
# CAP_PRO_VIDEO=-1

# Founding-user reward: signed up on or before FOUNDER_CUTOFF *and* completed at
# least FOUNDER_MIN_ROLEPLAYS. Both gates, so it rewards loyalty rather than
# just timing — a dormant early account hasn't earned it.
# FOUNDER_CUTOFF=2026-12-31
# FOUNDER_MIN_ROLEPLAYS=5
# FOUNDER_REWARD=first month of Pro free

# Video analysis model. Three yes/no observations per downscaled frame is a
# coarse perception task, not a reasoning one, so the fast/cheap model is the
# right fit and is what keeps a video session at cents rather than dollars.
# ANTHROPIC_VIDEO_MODEL=claude-haiku-4-5
