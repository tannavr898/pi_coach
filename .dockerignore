# Keep the build context small and never bake secrets/copyright into the image.
.git
**/node_modules
**/dist
**/.venv
**/__pycache__
**/*.pyc
*.log
*.tsbuildinfo

# Secrets — keys are injected as runtime env vars, never copied in.
backend/.env
backend/.env.*

# Raw DECA source files (PDFs, exams). Runtime data is built into backend/app/data.
backend/reference
